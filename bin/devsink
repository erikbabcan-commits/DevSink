#!/usr/bin/env bash
# ==============================================================================
#  ⚡ DevSink Client CLI - Instant LAN Developer Cache & Telemetry Switcher
# ==============================================================================
#  Turns your local developer tools (npm, pnpm, pip, uv, docker, atuin) towards
#  your high-speed LAN DevSink appliance or cleanly reverts back to public upstreams.
# ==============================================================================

set -e

VERSION="1.0.0"
DEFAULT_HOST="${DEVSINK_HOST:-vorkei.local}"

# Colors
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

print_banner() {
    echo -e "${CYAN}${BOLD}"
    echo "  ⚡  D E V S I N K   C L I  (v${VERSION})"
    echo "  High-Speed LAN Developer Cache & Appliance Switcher"
    echo -e "${NC}"
}

usage() {
    print_banner
    echo -e "${BOLD}USAGE:${NC}"
    echo "  devsink <command> [host]"
    echo ""
    echo -e "${BOLD}COMMANDS:${NC}"
    echo -e "  ${GREEN}on${NC} [host]     Point npm, pnpm, pip, uv, docker, atuin to DevSink node (default: ${DEFAULT_HOST})"
    echo -e "  ${YELLOW}off${NC}           Revert all tools back to default public upstream registries"
    echo -e "  ${CYAN}status${NC} [host]  Check connectivity & response latency to all DevSink microservices"
    echo -e "  ${BLUE}sync${NC}          Sync terminal command history with Atuin node"
    echo -e "  ${RED}purge${NC}         Purge local caches on this laptop to free up SSD space immediately"
    echo -e "  ${BOLD}bench${NC} [host]   Benchmark LAN cache speed vs public upstream"
    echo -e "  ${BOLD}version${NC}       Print DevSink version"
    echo ""
    echo -e "${BOLD}EXAMPLES:${NC}"
    echo "  devsink on                   # Connect to vorkei.local"
    echo "  devsink on 192.168.7.7       # Connect via direct IP"
    echo "  devsink status               # Check service health and ping"
    echo "  devsink off                  # Revert before leaving home network"
    echo ""
}

check_tool() {
    command -v "$1" >/dev/null 2>&1
}

# ------------------------------------------------------------------------------
# COMMAND: STATUS
# ------------------------------------------------------------------------------
cmd_status() {
    local host="${1:-$DEFAULT_HOST}"
    print_banner
    echo -e "${BOLD}🔍 Probing DevSink Node:${NC} ${CYAN}${host}${NC}"
    echo "--------------------------------------------------------"

    probe_service() {
        local name="$1"
        local port="$2"
        local path="$3"
        local start_ts end_ts latency_ms http_code

        start_ts=$(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))')
        http_code=$(curl -s -o /dev/null -w "%{http_code}" --connect-timeout 2 "http://${host}:${port}${path}" 2>/dev/null || echo "000")
        end_ts=$(date +%s%N 2>/dev/null || python3 -c 'import time; print(int(time.time()*1e9))')

        latency_ms=$(( (end_ts - start_ts) / 1000000 ))
        [ "$latency_ms" -lt 0 ] && latency_ms=1

        if [ "$http_code" = "200" ] || [ "$http_code" = "401" ] || [ "$http_code" = "404" ]; then
            printf "  %-24s : ${GREEN}● ACTIVE${NC} (HTTP %s, %3d ms) -> http://%s:%s\n" "$name" "$http_code" "$latency_ms" "$host" "$port"
        else
            printf "  %-24s : ${RED}○ OFFLINE${NC} (Unreachable) -> http://%s:%s\n" "$name" "$host" "$port"
        fi
    }

    probe_service "📦 NPM / Verdaccio"     "4873" "/"
    probe_service "🐳 Docker Registry"     "5000" "/v2/"
    probe_service "🐍 PyPI / ProxPi"       "5050" "/"
    probe_service "📜 Atuin History Sync"  "8888" "/"
    probe_service "📊 VictoriaLogs Core"   "9428" "/health"
    probe_service "🎛️ Mission Control UI"  "3333" "/"
    echo "--------------------------------------------------------"

    # Current local configuration state check
    echo -e "${BOLD}💻 Current Client Configuration:${NC}"
    local current_npm=$(npm config get registry 2>/dev/null || echo "not set")
    local current_pnpm=$(pnpm config get registry 2>/dev/null || echo "not set")
    local current_pip="${PIP_INDEX_URL:-$(pip config get global.index-url 2>/dev/null || echo "not set")}"

    echo -e "  NPM Registry:   ${CYAN}${current_npm}${NC}"
    echo -e "  PNPM Registry:  ${CYAN}${current_pnpm}${NC}"
    echo -e "  PIP Index:      ${CYAN}${current_pip}${NC}"
    echo ""
}

# ------------------------------------------------------------------------------
# COMMAND: ON
# ------------------------------------------------------------------------------
cmd_on() {
    local host="${1:-$DEFAULT_HOST}"
    print_banner
    echo -e "${BOLD}🚀 Switching Developer Tools to DevSink (${host})...${NC}\n"

    # 1. NPM & PNPM
    if check_tool npm; then
        npm config set registry "http://${host}:4873/"
        echo -e "  ${GREEN}✓${NC} NPM configured -> http://${host}:4873/"
    fi
    if check_tool pnpm; then
        pnpm config set registry "http://${host}:4873/"
        echo -e "  ${GREEN}✓${NC} PNPM configured -> http://${host}:4873/"
    fi
    if check_tool yarn; then
        yarn config set registry "http://${host}:4873/" 2>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Yarn configured -> http://${host}:4873/"
    fi

    # 2. Python / pip & uv
    mkdir -p ~/.config/pip
    cat <<EOF > ~/.config/pip/pip.conf
[global]
index-url = http://${host}:5050/simple/
trusted-host = ${host}
EOF
    echo -e "  ${GREEN}✓${NC} PIP configured (~/.config/pip/pip.conf) -> http://${host}:5050/simple/"

    mkdir -p ~/.config/uv
    cat <<EOF > ~/.config/uv/uv.toml
index-url = "http://${host}:5050/simple/"
allow-insecure-host = ["${host}"]
EOF
    echo -e "  ${GREEN}✓${NC} UV configured (~/.config/uv/uv.toml) -> http://${host}:5050/simple/"

    # 3. Docker Insecure & Mirror Registry
    local docker_config_dir="$HOME/.docker"
    local docker_daemon_file="/etc/docker/daemon.json"
    mkdir -p "$docker_config_dir"

    # Check if we can write docker daemon or suggest snippet
    echo -e "  ${BLUE}ℹ${NC} Docker registry mirror: add to /etc/docker/daemon.json (or Docker Desktop settings):"
    echo -e "    ${BOLD}{\"registry-mirrors\": [\"http://${host}:5000\"], \"insecure-registries\": [\"${host}:5000\"]}${NC}"

    # 4. Atuin
    if check_tool atuin; then
        mkdir -p ~/.config/atuin
        atuin config set sync_address "http://${host}:8888" 2>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Atuin sync address configured -> http://${host}:8888"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}✨ DevSink is now ACTIVE!${NC} All package downloads will now hit your local LAN SSD cache."
    echo -e "   Mission Control Web UI: ${CYAN}http://${host}:3333${NC}"
}

# ------------------------------------------------------------------------------
# COMMAND: OFF
# ------------------------------------------------------------------------------
cmd_off() {
    print_banner
    echo -e "${BOLD}🔄 Reverting Developer Tools to Public Upstreams...${NC}\n"

    # 1. NPM & PNPM
    if check_tool npm; then
        npm config set registry "https://registry.npmjs.org/"
        echo -e "  ${GREEN}✓${NC} NPM reverted -> https://registry.npmjs.org/"
    fi
    if check_tool pnpm; then
        pnpm config set registry "https://registry.npmjs.org/"
        echo -e "  ${GREEN}✓${NC} PNPM reverted -> https://registry.npmjs.org/"
    fi
    if check_tool yarn; then
        yarn config set registry "https://registry.yarnpkg.com/" 2>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Yarn reverted -> https://registry.yarnpkg.com/"
    fi

    # 2. Python / pip & uv
    if [ -f ~/.config/pip/pip.conf ]; then
        rm -f ~/.config/pip/pip.conf
        echo -e "  ${GREEN}✓${NC} PIP reverted (~/.config/pip/pip.conf removed)"
    fi
    if [ -f ~/.config/uv/uv.toml ]; then
        rm -f ~/.config/uv/uv.toml
        echo -e "  ${GREEN}✓${NC} UV reverted (~/.config/uv/uv.toml removed)"
    fi

    # 3. Atuin
    if check_tool atuin; then
        atuin config set sync_address "https://api.atuin.sh" 2>/dev/null || true
        echo -e "  ${GREEN}✓${NC} Atuin reverted -> https://api.atuin.sh"
    fi

    echo ""
    echo -e "${YELLOW}${BOLD}✓ DevSink disconnected.${NC} Your laptop is now using direct internet connections."
}

# ------------------------------------------------------------------------------
# COMMAND: PURGE
# ------------------------------------------------------------------------------
cmd_purge() {
    print_banner
    echo -e "${RED}${BOLD}🧹 Purging Local Caches on Laptop to Free SSD Space...${NC}\n"

    local freed_msg=""

    if check_tool pnpm; then
        echo -n "  Pruning PNPM global store... "
        pnpm store prune 2>/dev/null || true
        echo -e "${GREEN}Done${NC}"
    fi

    if check_tool npm; then
        echo -n "  Cleaning NPM cache... "
        npm cache clean --force 2>/dev/null || true
        echo -e "${GREEN}Done${NC}"
    fi

    if check_tool pip; then
        echo -n "  Purging PIP cache... "
        pip cache purge 2>/dev/null || true
        echo -e "${GREEN}Done${NC}"
    fi

    if check_tool uv; then
        echo -n "  Cleaning UV cache... "
        uv cache clean 2>/dev/null || true
        echo -e "${GREEN}Done${NC}"
    fi

    if check_tool docker; then
        echo -n "  Pruning Docker builder cache... "
        docker builder prune -f 2>/dev/null || true
        echo -e "${GREEN}Done${NC}"
    fi

    echo ""
    echo -e "${GREEN}${BOLD}✨ Local disk cleanup complete!${NC} All dependencies can now be fetched instantly from DevSink."
}

# ------------------------------------------------------------------------------
# COMMAND: SYNC
# ------------------------------------------------------------------------------
cmd_sync() {
    print_banner
    if check_tool atuin; then
        echo -e "${BOLD}🔄 Syncing Atuin Shell History...${NC}"
        atuin sync
        echo -e "${GREEN}✓ Shell history synchronized with DevSink!${NC}"
    else
        echo -e "${YELLOW}Atuin is not installed on this machine. (https://atuin.sh)${NC}"
    fi
}

# ------------------------------------------------------------------------------
# COMMAND: BENCHMARK
# ------------------------------------------------------------------------------
cmd_bench() {
    local host="${1:-$DEFAULT_HOST}"
    print_banner
    echo -e "${BOLD}⚡ Running LAN vs WAN Latency Benchmark (${host}):${NC}\n"

    echo -n "  [1/2] Fetching package metadata from DevSink LAN cache (http://${host}:4873)... "
    local time_lan=$(curl -o /dev/null -s -w "%{time_total}\n" "http://${host}:4873/react" 2>/dev/null || echo "N/A")
    echo -e "${GREEN}${time_lan}s${NC}"

    echo -n "  [2/2] Fetching package metadata from Public WAN npmjs.org... "
    local time_wan=$(curl -o /dev/null -s -w "%{time_total}\n" "https://registry.npmjs.org/react" 2>/dev/null || echo "N/A")
    echo -e "${YELLOW}${time_wan}s${NC}"

    echo ""
    echo -e "${CYAN}${BOLD}Result:${NC} DevSink response time is typically 5x to 15x faster with 0 WAN bandwidth used."
}

# Entrypoint Router
case "$1" in
    on)
        cmd_on "$2"
        ;;
    off)
        cmd_off
        ;;
    status)
        cmd_status "$2"
        ;;
    sync)
        cmd_sync
        ;;
    purge)
        cmd_purge
        ;;
    bench)
        cmd_bench "$2"
        ;;
    version|--version|-v)
        echo "DevSink CLI v${VERSION}"
        ;;
    *)
        usage
        exit 1
        ;;
esac
